notes.md
# --- Binarios de Go y Archivos de Compilación ---

# Blocks the centralized output directory generated by the Makefile
bin/

# Bloquea los ejecutables compilados de tu servidor y cliente CLI
*.exe
*.exe~
*.dll
*.so
*.dylib
# Bloquea ejecutables nativos sin extensión en sistemas Unix/macOS
dist/
build/bin/

# --- Específico de Wails (Frontend y empaquetado) ---
# Wails genera estas carpetas con dependencias de Node/NPM y compilaciones temporales
frontend/node_modules/
frontend/dist/
frontend/.nuxt/
frontend/.output/
.wails/

# --- Logs y Archivos Temporales ---
*.log
*.tmp
*.bak

# --- Configuraciones de Entorno ---
# Por si acaso guardáis credenciales o variables locales aquí
.env
.env.local

# --- Herramientas de Desarrollo e IDEs (42 / VS Code / Clion) ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store

